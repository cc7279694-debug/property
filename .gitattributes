# 原始规划阅读版按原字节保存，避免本机换行转换改变来源校验值。
LITHIC_V1_*.md -text
# 原始规划包、解包文件按来源字节保存，不应用换行转换。
docs/planning/original-v1/** -text
# Gradle shell entry point must keep LF when cloned on Windows.
gradlew text eol=lf
gradlew.bat text eol=crlf
gradle/wrapper/gradle-wrapper.jar -text
gradle/wrapper/gradle-wrapper.properties text eol=lf
docs/evidence/m10-tests/** -text
docs/evidence/m10-device/** -text
docs/evidence/m10-jpeg-supplement/** -text
docs/design/ui-c1/source-v1/** -text
docs/design/ui-c1/source-v2/** -text

# UI stage evidence keeps the original command, XML, JSON and screenshot bytes.
docs/evidence/ui-c1/stage1/** -text
docs/evidence/ui-c1/refinement/** -text

# UI-C1 stage2 request and actual execution evidence retain original bytes.
docs/design/ui-c1/source-stage2/** -text whitespace=cr-at-eol
docs/evidence/ui-c1/stage2/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
