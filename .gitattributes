# 原始规划阅读版按原字节保存，避免本机换行转换改变来源校验值。
LITHIC_V1_*.md -text
# 原始规划包、解包文件按来源字节保存，不应用换行转换。
docs/planning/original-v1/** -text
# Gradle shell entry point must keep LF when cloned on Windows.
gradlew text eol=lf
gradlew.bat text eol=crlf
gradle/wrapper/gradle-wrapper.jar -text
gradle/wrapper/gradle-wrapper.properties text eol=lf
# M11-A actual command/XML evidence retains recorded bytes, including failed runs.
docs/evidence/m11a/** -text -whitespace

# M11-B raw build, test and failed environment evidence keeps actual recorded bytes.
docs/evidence/m11b/** -text -whitespace

# M11-B final raw evidence retains command/XML bytes, including failed attempts.
docs/evidence/m11b-final/** -text -whitespace

# M12 raw command, XML and restore evidence keeps its observed bytes.
docs/evidence/m12/** -text -whitespace
# M12 real self-termination evidence must preserve raw PTY/exec-out byte differences.
docs/evidence/m12-process-death/** -text -whitespace

# M13 captured command, XML and screenshot evidence retains its exact bytes.
docs/evidence/m13/** -text -whitespace

# M14 command/XML evidence keeps observed bytes, including failures and NOT_RUN.
docs/evidence/m14/** -text -whitespace

# M14 isolated Android command and screenshot evidence preserves exact captured bytes.
docs/evidence/m14-android/** -text -whitespace

# M15 captured command, test and screenshot evidence preserves observed bytes.
docs/evidence/m15/** -text -whitespace

# M16 raw command/test/screenshot evidence preserves observed bytes.
docs/evidence/m16/** -text -whitespace
app/src/androidTest/assets/m16/** -text

# Room exports are immutable version fixtures; package original Git bytes on Windows.
app/schemas/** -text

# M17 raw test/device/screenshot evidence preserves observed bytes.
docs/evidence/m17/** -text -whitespace

# M18 actual RED/GREEN and build records retain observed bytes, including NOT_RUN.
docs/evidence/m18/** -text -whitespace

# M18 isolated Android evidence retains its actual recorded bytes.
docs/evidence/m18-android/** -text -whitespace

# M19 raw test/build/device/screenshot evidence preserves captured bytes.
docs/evidence/m19/** -text -whitespace

# M20 actual RED/GREEN, artifact and NOT_RUN records retain their captured bytes.
docs/evidence/m20/** -text -whitespace

# M20 isolated Android command, failed-run and screenshot evidence keeps captured bytes.
docs/evidence/m20-android/** -text -whitespace

# M20 second-run closure keeps original command and stop evidence bytes.
docs/evidence/m20-platform-closure/** -text -whitespace

# M21 authorized isolated Android command/test/screenshot evidence keeps observed bytes.
docs/evidence/m21-android/** -text -whitespace
