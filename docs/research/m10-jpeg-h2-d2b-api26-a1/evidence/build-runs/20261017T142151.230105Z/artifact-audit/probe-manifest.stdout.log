<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="r3-research"
    android:compileSdkVersion="36"
    android:compileSdkVersionCodename="16"
    package="com.cooper.lithic.m10r3.probe"
    platformBuildVersionCode="36"
    platformBuildVersionName="16">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <application
        android:theme="@ref/0x1030241"
        android:label="LITHIC R3 RESEARCH ONLY"
        android:name="com.cooper.lithic.m10r3.probe.ProbeApplication"
        android:debuggable="true"
        android:allowBackup="false"
        android:extractNativeLibs="false">

        <activity
            android:name="com.cooper.lithic.m10r3.probe.ProbeActivity"
            android:exported="true"
            android:launchMode="1">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.cooper.lithic.m10r3.probe.WorkerService"
            android:exported="false"
            android:process=":jpeg_worker"
            android:stopWithTask="false" />
    </application>
</manifest>
