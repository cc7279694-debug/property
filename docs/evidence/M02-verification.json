      "app/src/main/java/com/cooper/lithic/core/model/DomainModels.kt": "package com.cooper.lithic.core.model\n\nimport java.math.BigDecimal\nimport java.time.LocalDate\n\nenum class MoneyDirection { OUTLAY, RECOVERY }\n\ndata class LongTermProject(val startedOn: LocalDate, val endedOn: LocalDate? = null)\n\ndata class ProjectMoneyEvent(val direction: MoneyDirection, val amount: Money, val occurredOn: LocalDate)\n\ndata class ProjectSnapshot(val project: LongTermProject, val moneyEvents: List<ProjectMoneyEvent>)\n\nenum class CostUnavailableReason { PROJECT_NOT_STARTED }\n\ndata class ProjectCostResult(\n    val heldDays: Long,\n    val grossOutlayCents: Long,\n    val recoveryCents: Long,\n    val netCents: Long,\n    val dailyRate: BigDecimal?,\n    val contributesToCurrentTotal: Boolean,\n    val unavailableReason: CostUnavailableReason?,\n)\n",
      "app/src/main/java/com/cooper/lithic/core/model/Money.kt": "package com.cooper.lithic.core.model\n\ndata class Money(val cents: Long)\n\nenum class MoneyParseError { INVALID_FORMAT, EXCESS_PRECISION, OUT_OF_RANGE }\n\nsealed interface MoneyParseResult {\n    data class Success(val money: Money) : MoneyParseResult\n    data class Failure(val reason: MoneyParseError) : MoneyParseResult\n}\n\nobject MoneyParser {\n    fun parseCny(text: String): MoneyParseResult = MoneyParseResult.Failure(MoneyParseError.INVALID_FORMAT)\n}\n",
      "app/src/main/java/com/cooper/lithic/core/time/BusinessClock.kt": "package com.cooper.lithic.core.time\n\nimport java.time.Clock\nimport java.time.LocalDate\n\nfun interface BusinessClock {\n    fun today(): LocalDate\n}\n\nclass FixedBusinessClock(private val date: LocalDate) : BusinessClock {\n    override fun today(): LocalDate = LocalDate.MIN\n}\n\nclass ZonedBusinessClock(private val clock: Clock) : BusinessClock {\n    override fun today(): LocalDate = LocalDate.MIN\n}\n",
      "app/src/main/java/com/cooper/lithic/domain/project/ProjectCostEngine.kt": "package com.cooper.lithic.domain.project\n\nimport com.cooper.lithic.core.model.CostUnavailableReason\nimport com.cooper.lithic.core.model.ProjectCostResult\nimport com.cooper.lithic.core.model.ProjectSnapshot\nimport java.time.LocalDate\n\nobject ProjectCostEngine {\n    fun evaluate(input: ProjectSnapshot, asOf: LocalDate): ProjectCostResult = ProjectCostResult(\n        heldDays = 0,\n        grossOutlayCents = 0,\n        recoveryCents = 0,\n        netCents = 0,\n        dailyRate = null,\n        contributesToCurrentTotal = false,\n        unavailableReason = CostUnavailableReason.PROJECT_NOT_STARTED,\n    )\n}\n"
    },
