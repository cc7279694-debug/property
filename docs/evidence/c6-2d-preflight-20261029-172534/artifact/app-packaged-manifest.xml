<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cooper.lithic.c6isolation.debug"
    android:versionCode="17"
    android:versionName="0.1.0-c6isolation-debug" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <permission
        android:name="com.cooper.lithic.c6isolation.debug.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.cooper.lithic.c6isolation.debug.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />
    <!--
 Host uses M13IsolatedRunner's plain Application. The separately launched sandbox must
         retain the real LithicApplication so its production role gate is actually exercised.
    -->
    <application
        android:name="com.cooper.lithic.app.LithicApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="砺石·隔离验证"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lithic" >

        <!-- Retained for the existing Startup contract, with NO initializer metadata. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.cooper.lithic.c6isolation.debug.androidx-startup"
            android:exported="false"
            android:process="com.cooper.lithic.c6isolation.debug" />

        <service
            android:name="com.cooper.lithic.data.media.isolation.MediaSandboxService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":media_sandbox" />
    </application>

</manifest>